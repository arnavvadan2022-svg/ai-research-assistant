# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=research_assistant
DB_USER=postgres
DB_PASSWORD=your-database-password

# Groq API Key (used for all AI features — Knowledge Graph, summarisation, analysis)
GROQ_API_KEY=your-groq-api-key-here
# Optional: override the default Groq model (default: llama3-8b-8192)
GROQ_MODEL=llama3-8b-8192

# OpenAI API Key (legacy — Groq is preferred)
OPENAI_API_KEY=your-openai-api-key-here

# Application Settings
MAX_SEARCH_RESULTS=50
SUMMARY_MAX_LENGTH=500